config BOARD_ANISECTLC
    select SOC_NRF52840_QIAA
    select ZMK_BOARD_COMPAT
    # Required by nrf52840_uf2_boot_mode.dtsi, which backs double-tap-reset
    imply RETAINED_MEM
    imply RETENTION
    imply RETENTION_BOOT_MODE
