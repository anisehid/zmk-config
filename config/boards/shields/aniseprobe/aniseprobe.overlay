#include <dt-bindings/zmk/matrix_transform.h>

/*
 * Probe shield. Columns are the known-good 21..27; every other
 * connector pin is scanned as a row. Press a key and the log reports the row
 * index that fired -- map it back with the table below.
 *
// row index 0  = anise_ctl 11
// row index 1  = anise_ctl 12
// row index 2  = anise_ctl 13
// row index 3  = anise_ctl 14
// row index 4  = anise_ctl 15
// row index 5  = anise_ctl 16
// row index 6  = anise_ctl 1
// row index 7  = anise_ctl 2
// row index 8  = anise_ctl 3
// row index 9  = anise_ctl 4
// row index 10 = anise_ctl 5
// row index 11 = anise_ctl 28
// row index 12 = anise_ctl 31
// row index 13 = anise_ctl 32
// row index 14 = anise_ctl 33
// row index 15 = anise_ctl 34
// row index 16 = anise_ctl 35
// row index 17 = anise_ctl 36
// row index 18 = anise_ctl 37
 */

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <19>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6)
RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6)
RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(6,5) RC(6,6)
RC(7,0) RC(7,1) RC(7,2) RC(7,3) RC(7,4) RC(7,5) RC(7,6)
RC(8,0) RC(8,1) RC(8,2) RC(8,3) RC(8,4) RC(8,5) RC(8,6)
RC(9,0) RC(9,1) RC(9,2) RC(9,3) RC(9,4) RC(9,5) RC(9,6)
RC(10,0) RC(10,1) RC(10,2) RC(10,3) RC(10,4) RC(10,5) RC(10,6)
RC(11,0) RC(11,1) RC(11,2) RC(11,3) RC(11,4) RC(11,5) RC(11,6)
RC(12,0) RC(12,1) RC(12,2) RC(12,3) RC(12,4) RC(12,5) RC(12,6)
RC(13,0) RC(13,1) RC(13,2) RC(13,3) RC(13,4) RC(13,5) RC(13,6)
RC(14,0) RC(14,1) RC(14,2) RC(14,3) RC(14,4) RC(14,5) RC(14,6)
RC(15,0) RC(15,1) RC(15,2) RC(15,3) RC(15,4) RC(15,5) RC(15,6)
RC(16,0) RC(16,1) RC(16,2) RC(16,3) RC(16,4) RC(16,5) RC(16,6)
RC(17,0) RC(17,1) RC(17,2) RC(17,3) RC(17,4) RC(17,5) RC(17,6)
RC(18,0) RC(18,1) RC(18,2) RC(18,3) RC(18,4) RC(18,5) RC(18,6)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        col-gpios
            = <&anise_ctl 21 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 22 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 23 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 24 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 25 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 26 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 27 GPIO_ACTIVE_HIGH>
            ;

        row-gpios
            = <&anise_ctl 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 32 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 33 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 34 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 35 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 36 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 37 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
