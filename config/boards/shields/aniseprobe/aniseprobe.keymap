#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/* All positions are &none on purpose: the kscan driver still logs every press,
 * but nothing is typed into the terminal you are reading the log in. */

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
    &none &none &none &none &none &none &none
            >;
        };
    };
};
