/*
 * Temporary probe, flashed on the anise85a RIGHT half as a standalone board
 * with USB logging. Rows 0-5: the right-half matrix exactly as
 * anise85a_right.overlay scans it (kscan columns 0-8 = keymap columns 7-15).
 * Row 6: every spare anise_ctl pin, read directly with pull-ups, so an
 * encoder whose common goes to GND shows up as "Sending event at 0,<n>".
 *
 * Direct index -> anise_ctl pin: 0:1 1:3 2:4 3:5 4:32 5:33 6:34 7:35 8:36 9:37
 * (2 is RGB data, 38 is ext-power -- not probed.)
 */

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <7>;
        columns = <10>;

        matrix {
            kscan = <&kscan_matrix>;
        };

        direct {
            kscan = <&kscan_direct>;
            row-offset = <6>;
        };
    };

    kscan_matrix: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        col-gpios
            = <&anise_ctl 21 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 22 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 23 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 24 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 25 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 26 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 27 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 28 GPIO_ACTIVE_HIGH>
            , <&anise_ctl 31 GPIO_ACTIVE_HIGH>
            ;
        row-gpios
            = <&anise_ctl 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&anise_ctl 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    kscan_direct: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios
            = <&anise_ctl 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&anise_ctl 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&anise_ctl 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&anise_ctl 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&anise_ctl 32 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&anise_ctl 33 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&anise_ctl 34 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&anise_ctl 35 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&anise_ctl 36 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&anise_ctl 37 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };
};
